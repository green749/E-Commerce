# ==============================================================================
# 1. DATABASE CONFIGURATION (Aiven Cloud PostgreSQL)
# ==============================================================================
# OPTION A: Full Service URI from Aiven Console:
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@your-service.aivencloud.com:12345/defaultdb?sslmode=require

# OPTION B: Individual fields from Aiven:
AIVEN_PG_HOST=your-service.aivencloud.com
AIVEN_PG_PORT=12345
AIVEN_PG_USER=avnadmin
AIVEN_PG_PASSWORD=your_password
AIVEN_PG_DATABASE=defaultdb
AIVEN_PG_SSLMODE=require

# ==============================================================================
# 2. SERVER CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development

# ==============================================================================
# 3. CORS
# ==============================================================================
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,https://e-commerce-eta-eight-46.vercel.app,https://e-commerce-ur8e.onrender.com

# ==============================================================================
# 4. JWT AUTHENTICATION TOKENS
# ==============================================================================
JWT_ACCESS_SECRET=your_super_secret_access_token_key_min_32_chars_12345
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_min_32_chars_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

